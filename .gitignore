# Dependencies
node_modules

# Environment variables
# .env e .env.production sao commitados de proposito: tudo em VITE_* vai para o bundle publico.
# Overrides locais ficam em .env.local (nao commitar).
.env.local
.env.*.local

# Build output
dist
dist.previous
dist.new
dist-ssr
*.local
# Snapshots de deploy (dist antigos preservados pelo fluxo de swap) — nunca commitar
dist-bak/
dist-old-*/
dist.bak-*/
*.PREPULL.js

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Harness de regressao de firmware: os DADOS embutem topicos MQTT e nomes de
# plantas reais (extraidos de iot_projetos). Versiona-se so' o harness (.mjs);
# regenerar localmente com:  node scripts/regressao-firmware-v1.mjs --baseline
scripts/regressao-corpus.json
scripts/regressao-baseline.json
scripts/regressao-catalog.snapshot.js
